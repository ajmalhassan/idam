{
  "name": "idam-new-tab",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src tests scripts public review package.json .prettierrc.json",
    "format:check": "prettier --check src tests scripts public review package.json .prettierrc.json",
    "check": "npm run format:check && npm test",
    "package": "node scripts/package.mjs",
    "check:browser": "node scripts/beta-browser-check.mjs",
    "prepare:beta": "node scripts/prepare-beta.mjs",
    "capture:promo": "node scripts/beta-promo.mjs"
  },
  "dependencies": {
    "@pane-ui/react": "file:vendor/pane-ui-react",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "prettier": "3.6.2"
  }
}
